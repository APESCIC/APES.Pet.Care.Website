{
    "version":  "2.0.0",
    "tasks":  [
                  {
                      "label":  "Herd live preview (scripts/preview.ps1)",
                      "type":  "shell",
                      "command":  "powershell",
                      "args":  [
                                   "-NoProfile",
                                   "-ExecutionPolicy",
                                   "Bypass",
                                   "-File",
                                   "${workspaceFolder}/scripts/preview.ps1"
                               ],
                      "options":  {
                                      "cwd":  "${workspaceFolder}"
                                  },
                      "presentation":  {
                                           "reveal":  "always",
                                           "panel":  "dedicated",
                                           "clear":  true
                                       },
                      "problemMatcher":  [

                                         ]
                  },
                  {
                      "label":  "PHP lint dev/sync-site-chrome.php",
                      "type":  "shell",
                      "command":  "php84",
                      "args":  [
                                   "-l",
                                   "dev/sync-site-chrome.php"
                               ],
                      "options":  {
                                      "cwd":  "${workspaceFolder}"
                                  },
                      "presentation":  {
                                           "reveal":  "always",
                                           "panel":  "dedicated",
                                           "clear":  true
                                       },
                      "problemMatcher":  [

                                         ]
                  },
                  {
                      "label":  "Check synced site chrome",
                      "type":  "shell",
                      "command":  "php84",
                      "args":  [
                                   "dev/sync-site-chrome.php",
                                   "--check"
                               ],
                      "options":  {
                                      "cwd":  "${workspaceFolder}"
                                  },
                      "presentation":  {
                                           "reveal":  "always",
                                           "panel":  "dedicated",
                                           "clear":  true
                                       },
                      "problemMatcher":  [

                                         ]
                  }
              ]
}
